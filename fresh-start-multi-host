#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

source compose-configs/shared-infra/detect-engine.sh
source compose-configs/shared-infra/compose-build-flags.sh

# Other hosts must reach these ports, so bind every interface unless the
# caller chose an address (e.g. one NIC) by setting EGERIA_BIND_IP.
if [[ "${EGERIA_BIND_IP_AUTO:-0}" -eq 1 ]]; then
  export EGERIA_BIND_IP="0.0.0.0"
fi
echo "[fresh-start-multi-host] Published ports bind to ${EGERIA_BIND_IP}."

echo "[fresh-start-multi-host] Preparing environment (.env) and compose files..."
echo "[fresh-start-multi-host] Freshstart uses runtime-volumes/freshstart-platform-data mounted at /deployments."

RUNTIME_DEPLOYMENTS_DIR="runtime-volumes/freshstart-platform-data"
RUNTIME_SECRETS_DIR="runtime-volumes/freshstart-platform-data/secrets"
TEMPLATE_SECRETS_DIR="compose-configs/egeria-freshstart/secrets"

prepare_runtime_dir "$RUNTIME_DEPLOYMENTS_DIR"
mkdir -p "$RUNTIME_SECRETS_DIR"

# Seed secrets from templates only for files that don't already exist. An existing file keeps its content
# (the user directory is edited in place), except that the secrets whose passwords come from shared-infra/.env
# (TR-28: PROVISIONER_PASSWORD) are filled in again, so a rotated password reaches them. gen-env.sh first, so
# the value exists; ensure-shared-infra.sh below runs it again, which keeps the same value.
echo "[fresh-start-multi-host] Installing runtime secrets from templates in ${TEMPLATE_SECRETS_DIR} (existing files are kept)..."
compose-configs/shared-infra/gen-env.sh
python3 compose-configs/shared-infra/install-secrets.py --keep-existing "${TEMPLATE_SECRETS_DIR}" "$RUNTIME_SECRETS_DIR"

TARGET_SERVER_DIR="runtime-volumes/freshstart-platform-data/data/servers"
echo "[fresh-start-multi-host] Copying freshstart server configurations to ${TARGET_SERVER_DIR}..."
safe_rm_rf "$TARGET_SERVER_DIR"
mkdir -p "$TARGET_SERVER_DIR"
cp compose-configs/egeria-quickstart/servers/*.http "$TARGET_SERVER_DIR"/
cp compose-configs/egeria-quickstart/servers/README.md "$TARGET_SERVER_DIR"/
cp -r compose-configs/egeria-quickstart/servers/fs-* "$TARGET_SERVER_DIR"/

compose-configs/shared-infra/ensure-shared-infra.sh

pushd compose-configs/egeria-freshstart >/dev/null
  # ── TLS: fall back to a self-signed cert unless the user has already ────
  # configured one in .env.ssl (or .env) — same mechanism fresh-start-local
  # uses (this is the same egeria-freshstart compose project, just with the
  # cluster overlay instead of local, so it shares CERT_DIR/.env.ssl/
  # ssl-define.conf with it).
  _get_env_var() {
    local key="$1" file="$2"
    [[ -f "$file" ]] && grep -E "^${key}=" "$file" | head -n1 | cut -d= -f2- || true
  }

  ENV_SSL=".env.ssl"
  _cert_dir="$(_get_env_var CERT_DIR "$ENV_SSL")"
  [[ -z "$_cert_dir" ]] && _cert_dir="$(_get_env_var CERT_DIR .env)"
  _https_port="$(_get_env_var HTTPS_PORT "$ENV_SSL")"
  _site_url_override="$(_get_env_var SITE_URL "$ENV_SSL")"

  if [[ -z "$_cert_dir" ]]; then
    _cert_dir="$(cd ../.. && pwd)/runtime-volumes/certs-freshstart"
  fi

  if [[ ! -f "${_cert_dir}/server.crt" || ! -f "${_cert_dir}/server.key" || ! -f "${_cert_dir}/server-ca.crt" ]]; then
    _cert_host="$(hostname -f 2>/dev/null || hostname)"
    echo "[fresh-start-multi-host] No TLS certificate found at ${_cert_dir}; generating a self-signed one for ${_cert_host}..."
    ../../generate-certs.sh "$_cert_dir" "$_cert_host"
  fi

  _https_port="${_https_port:-7843}"

  cat > "$ENV_SSL" <<EOF
CERT_DIR=${_cert_dir}
HTTPS_PORT=${_https_port}
SITE_URL=${_site_url_override}
EOF
  chmod 600 "$ENV_SSL"

  ./gen-env.sh
  # RK-24 (2026-11-18): stop here, in words, rather than let compose fail with "required variable … is missing".
  # Not just present: a value of "" or '' counts as missing too (read-back N2).
  if ! grep -E '^EGERIA_ADMIN_CALLER_PASSWORD=' .env | head -n1 | cut -d= -f2- | tr -d "\"'" | grep -q .; then
    cat >&2 <<'MSG'
[fresh-start-multi-host] STOP: EGERIA_ADMIN_CALLER_PASSWORD is not set.
  It is the password of the Egeria account the Portal acts as: EGERIA_ADMIN_CALLER_ID, which is
  "bootstrap" unless you changed it. On a brand-new freshstart it is bootstrap's initial password,
  given in compose-configs/egeria-freshstart/README.md ("First run").
  Add this line to compose-configs/egeria-freshstart/.env (git-ignored, never committed):
      EGERIA_ADMIN_CALLER_PASSWORD=<bootstrap's password>
  or export it in this shell, then run this script again.
  If you later change bootstrap's password (First run, step 4), update this value to match and re-run.
  See compose-configs/egeria-freshstart/README.md, "Required .env settings".
MSG
    exit 1
  fi

  _host_fqdn="$(grep '^HOST_FQDN=' .env | cut -d= -f2-)"
  if [[ -n "$_site_url_override" ]]; then
    _site_url="$_site_url_override"
  elif [[ "$_https_port" == "443" ]]; then
    _site_url="https://${_host_fqdn}"
  else
    _site_url="https://${_host_fqdn}:${_https_port}"
  fi
  {
    echo "CERT_DIR=${_cert_dir}"
    echo "HTTPS_PORT=${_https_port}"
    echo "SITE_URL=${_site_url}"
  } >> .env

  SSL_DEFINE_DIR="../../runtime-volumes/freshstart-apache-web"
  mkdir -p "$SSL_DEFINE_DIR"
  {
    printf 'Define SSL_SERVER_NAME %s\n' "${_host_fqdn}"
    printf 'Define HTTPS_REDIRECT_PORT %s\n' "${_https_port}"
  } > "${SSL_DEFINE_DIR}/ssl-define.conf"
  echo "[fresh-start-multi-host]   Self-signed HTTPS on port ${_https_port} (CERT_DIR=${_cert_dir}) — SITE_URL: ${_site_url}"

  # egeria-platform's Dockerfile FROM line is pinned to a digest (OpenSSF
  # Scorecard's Pinned-Dependencies check) -- re-resolve it first, or the
  # "pulling newer base images when available" build below would just keep
  # re-confirming the same old pinned digest forever. See
  # compose-configs/shared-infra/pin-latest-digest.sh's own docstring.
  # The image:tag to re-resolve is read from the Dockerfile's own FROM line,
  # as in fresh-start-local: a tag written here goes stale when the pin moves
  # to another version, and the re-pin then moves the platform back to it.
  _platform_image_tag="$(sed -nE 's/^FROM[[:space:]]+([^[:space:]@]*odpi\/egeria-platform:[^[:space:]@]+).*/\1/p' Dockerfile-egeria-platform | head -n 1)"
  if [[ -z "$_platform_image_tag" ]]; then
    echo "[fresh-start-multi-host] ERROR: found no 'FROM <registry>/odpi/egeria-platform:<tag>' line in Dockerfile-egeria-platform, so it does not know which tag to re-pin." >&2
    exit 1
  fi
  ../shared-infra/pin-latest-digest.sh Dockerfile-egeria-platform "$_platform_image_tag"

  echo "[fresh-start-multi-host] Building freshstart images (pulling newer base images when available)..."
  $COMPOSE_CMD -p egeria-freshstart -f egeria-freshstart.yaml build "${COMPOSE_BUILD_FLAGS[@]}"

  echo "[fresh-start-multi-host] Starting freshstart stack with external Kafka listeners..."
  # egeria-freshstart-docker.yaml keeps Jupyter waiting for a healthy platform on Docker
  # (left out for Podman: podman-compose 1.5.0 blocks indefinitely on service_healthy).
  COMPOSE_FILES=(-f egeria-freshstart.yaml -f egeria-freshstart-cluster.yaml -f egeria-freshstart-ssl.yaml)
  if [[ "$CONTAINER_ENGINE" != "podman" ]]; then
    COMPOSE_FILES+=(-f egeria-freshstart-docker.yaml)
  fi
  $COMPOSE_CMD -p egeria-freshstart \
    "${COMPOSE_FILES[@]}" \
    up -d ${COMPOSE_PULL_FLAGS}
popd >/dev/null

echo "[fresh-start-multi-host] Done. Useful notes:"
HOST_FQDN_PRINT=$(grep '^HOST_FQDN=' compose-configs/egeria-freshstart/.env | cut -d= -f2- || echo "localhost")
KAFKA_CLUSTER_ID_PRINT=$(grep '^KAFKA_CLUSTER_ID=' compose-configs/egeria-freshstart/.env | cut -d= -f2- || echo "42")
_site_url_print=$(grep '^SITE_URL=' compose-configs/egeria-freshstart/.env | cut -d= -f2- || echo "https://${HOST_FQDN_PRINT:-localhost}:7843")
echo "  - Effective HOST_FQDN: ${HOST_FQDN_PRINT}"
echo "  - Effective KAFKA_CLUSTER_ID: ${KAFKA_CLUSTER_ID_PRINT}"
echo "  - Egeria (platform):     https://${HOST_FQDN_PRINT:-localhost}:8443 (reachable from other hosts if DNS resolves)"
echo "  - Kafka external:        ${HOST_FQDN_PRINT:-localhost}:9194"
echo "  - JupyterHub (local):    http://localhost:7888   (password: egeria)"
echo "  - Egeria Portal (HTTPS): ${_site_url_print}  (http://…:7885 redirects here; reachable from other hosts if DNS resolves)"
echo "  - Portal is self-signed unless CERT_DIR is set in .env.ssl — accept the cert warning once."

