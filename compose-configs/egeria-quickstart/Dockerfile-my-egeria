FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# pip install of textual does not install the `textual` console script;
# use textual_serve.server.Server programmatically via serve_my_egeria.py instead.
# pyegeria in its own layer, same pattern as Dockerfile-jupyter — Docker caches
# it, so a plain rebuild keeps the previously-installed version. Override with
# --build-arg PYEGERIA_BUST=$(date +%s) (or PYEGERIA_VERSION=pyegeria==X.Y.Z),
# or NO_CACHE=1 ./redeploy-demo to refresh every image at once.
ARG PYEGERIA_VERSION=pyegeria
ARG PYEGERIA_BUST=0
RUN echo "pyegeria layer ${PYEGERIA_BUST}" \
    && pip install --no-cache-dir --retries 10 --timeout 60 "${PYEGERIA_VERSION}" --upgrade nest_asyncio
RUN pip install --no-cache-dir --retries 10 --timeout 60 "textual==6.1.0"
COPY serve_my_egeria.py /usr/local/bin/serve_my_egeria.py
# my_profile.tcss is missing from pyegeria's package_data (fixed upstream);
# inject it manually until a new pyegeria release includes it.
COPY my_profile.tcss /tmp/my_profile.tcss
RUN find /usr/local/lib -name "my_profile_app.py" \
    -exec sh -c 'cp /tmp/my_profile.tcss "$(dirname "$1")/my_profile.tcss"' _ {} \;
EXPOSE 8020
CMD ["python", "/usr/local/bin/serve_my_egeria.py"]
