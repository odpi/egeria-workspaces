# Portal image for Kubernetes / OpenShift (TR-112a). Compose does NOT use this file: it builds
# Dockerfile-fast-api and bind-mounts the code over /app. This image carries the code, runs
# without --reload, and runs as a non-root numeric UID with GID 0 so it also works under an
# arbitrary UID (OpenShift restricted-v2 assigns the UID and always uses GID 0).
#
# Build (from this directory):
#   docker build -f Dockerfile-portal-image -t portal-<env>:<env>-<egeria-release>-<short sha> .
#
# What is NOT baked in: the content compose mounts. See README-portal-images.md for each path.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/portal \
    PYEGERIA_LOG_DIRECTORY=/app/logs \
    EGERIA_ROOT_PATH=/app/dr-egeria \
    EGERIA_INBOX_PATH=dr-egeria-inbox \
    EGERIA_OUTBOX_PATH=dr-egeria-outbox

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --retries 10 --timeout 60 -r requirements.txt

# Same floor and cache-bust pattern as Dockerfile-fast-api.
ARG PYEGERIA_VERSION=pyegeria>=6.3.3
ARG PYEGERIA_BUST=0
RUN echo "pyegeria layer ${PYEGERIA_BUST}" \
    && pip install --no-cache-dir --retries 10 --timeout 60 "${PYEGERIA_VERSION}" --upgrade

COPY . .

# Every written path is group 0 with g=u, so any UID that carries GID 0 can write it.
#   $HOME/.pyegeria  pyegeria state: bootstrap ledger, dashboard sheets, notebook runs, report-spec cache
#   /app/logs        pyegeria and handler logs (PYEGERIA_LOG_DIRECTORY)
#   /app/dr-egeria   Dr.Egeria inbox and outbox (EGERIA_ROOT_PATH; compose sets it to "/", which a non-root user cannot write)
#   /app             the handler rebuilds egeria_request_body_catalog.json here (file and directory are g=u)
#   /app/demo-data, /app/workbench-access   runtime state (a chart mounts a volume over demo-data)
#   /tmp             Python temp files
RUN mkdir -p /home/portal/.pyegeria /app/logs /app/demo-data /app/workbench-access /app/dr-egeria \
    && chgrp -R 0 /home/portal /app/logs /app/demo-data /app/workbench-access /app/dr-egeria \
    && chmod -R g=u /home/portal /app/logs /app/demo-data /app/workbench-access /app/dr-egeria \
    && chgrp 0 /app && chmod g=u /app \
    && if [ -f /app/egeria_request_body_catalog.json ]; then chgrp 0 /app/egeria_request_body_catalog.json && chmod g=u /app/egeria_request_body_catalog.json; fi \
    && chmod 1777 /tmp

USER 1001:0
EXPOSE 8000

# No --reload. Binds IPv4 (0.0.0.0) because kubelet probes and Services use the pod IPv4 address.
# Compose binds "::", which asyncio makes IPv6-only; set PORTAL_BIND=:: on an IPv6-only cluster.
# umask 002: files the app creates are group-writable (g=u), so a later start under a different UID with GID 0
# (OpenShift assigns one per namespace, and it can change) can still write them.
CMD ["sh", "-c", "umask 002; exec uvicorn pyegeria_handler:app --host \"${PORTAL_BIND:-0.0.0.0}\" --port 8000 --loop asyncio"]
