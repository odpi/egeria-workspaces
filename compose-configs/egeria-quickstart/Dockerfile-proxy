# Build stages pinned to JDK 17, not the :24 the final image below uses —
# Dependabot's semver-major bump from :11 to :24 (upstream PR odpi#362,
# 2026-08-22) broke the build: Gradle 8.9 (gradle/wrapper/gradle-wrapper.
# properties) can't run on JDK 24 at all ("Unsupported class file major
# version 68" — Gradle didn't add JDK 24 support until well after 8.9), and
# JDK 21 isn't a fix either — Lombok 1.18.22 (see build.gradle) doesn't
# understand JDK 21's javac internals (NoSuchFieldError on
# com.sun.tools.javac.tree.JCTree$JCImport.qualid). 17 is the last LTS both
# Gradle 8.9 and this Lombok version fully support. The jar itself targets
# Java 11 (build.gradle sourceCompatibility/targetCompatibility) so building
# on 17 and running on the final stage's newer JDK below is safe either way
# — no need to revert Dependabot's runtime-image bump, just the build one.
FROM docker.io/library/eclipse-temurin:17@sha256:a27c79d44326d5f689668df5fedfee487652066d2a91e172747056cc7fbee6fc AS base
WORKDIR /usr/src/app
COPY gradle gradle
COPY gradle.properties gradle.properties
COPY gradlew gradlew
COPY settings.gradle settings.gradle
RUN ./gradlew --version

FROM base AS build
WORKDIR /usr/src/app
COPY src ./src
COPY build.gradle build.gradle
RUN ./gradlew --no-daemon shadowJar

FROM docker.io/library/eclipse-temurin:24@sha256:7493205ffe6caa8074fa8a06a276bb1c5ac41d3dd0fd43a0db66d7f776e80b3e
WORKDIR /usr/src/app
COPY --from=build /usr/src/app/build/libs/openlineage-proxy-*.jar /usr/src/app
COPY proxy.dev.yml proxy.dev.yml
COPY docker/entrypoint.sh entrypoint.sh
EXPOSE 6000 6001
ENTRYPOINT ["/usr/src/app/entrypoint.sh"]
