# ─────────────────────────────────────────────────────────────────────────────
# egeria-quickstart — environment configuration template
# Copy this file to .env and fill in values for your environment.
# .env is gitignored; .env.example is committed and kept up to date.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host / network ────────────────────────────────────────────────────────────
# Fully-qualified hostname of this machine (used by Egeria and Kafka).
HOST_FQDN=myhost.local

# Gateway IP Docker containers use to reach the host.
# Leave unset to use the default "host-gateway" magic hostname.
# HOST_GATEWAY_IP=192.168.1.50

# Host address published ports bind to (default 127.0.0.1: this machine only).
# Containers reach each other through host.docker.internal, which only answers
# a loopback-bound port under Docker Desktop. On native Docker Engine or Podman,
# running `docker compose` directly, set 0.0.0.0 or those callbacks fail.
# The quick-start/fresh-start scripts ignore this file's value and choose for
# you (Docker Desktop 127.0.0.1, otherwise and for --lan/--demo/multi-host
# 0.0.0.0); to override them, export EGERIA_BIND_IP in your shell before
# running them. On 127.0.0.1 the stack answers on localhost only, not on
# HOST_FQDN: use --lan to reach it by machine name or from other machines.
# EGERIA_BIND_IP=0.0.0.0

# Kafka bootstrap address reachable from inside containers.
KAFKA_BOOTSTRAP_SERVERS=myhost.local:9194


# ── Auth / JWT (demo mode) ────────────────────────────────────────────────────
# Signs the Portal's session cookies. Leave it unset: quick-start-local's gen-env.sh generates a random one
# into .env on the first run and keeps it (PO-46b). To choose your own: openssl rand -hex 32. The values once
# published here are refused.
# JWT_SECRET=

# Admin account auto-created on first startup in demo mode (DEMO_MODE=true).
# Leave blank to skip auto-bootstrap.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# ── Email / notifications (demo mode) ────────────────────────────────────────
# Resend (https://resend.com) is used for magic-link login emails.
# Leave blank to disable email; login links will appear in the server log instead.
RESEND_API_KEY=
RESEND_FROM=

# egeria-watchdog service: who gets emailed when quickstart-egeria-main dies
# (crash, OOM-kill, etc). Reuses RESEND_API_KEY/RESEND_FROM above. Leave blank
# to disable the alert (the watchdog logs a warning and skips sending).
ALERT_EMAIL_TO=

# egeria-upgrade-reset infra-check (launchd, every 10 min): who gets emailed when the
# shared-infra state changes. Blank = ALERT_EMAIL_TO. Sends through RESEND_* above (else
# SMTP_*, see PyegeriaWebHandler/demo-mode.md). Put it in .env.demo: .env is regenerated
# by quick-start-local, and infra-check (on the host) reads .env.demo first.
INFRA_ALERT_EMAIL=


# ── Obsidian integration ──────────────────────────────────────────────────────
# Set to false to disable the session lock entirely (single-user / freshstart).
# When disabled, the portal tile shows a direct link with no acquire/release flow.
OBSIDIAN_LOCK_ENABLED=true

# Controls which Obsidian the portal tile opens.
#
#   Empty (default) — portal opens the containerized Obsidian at port 3000.
#
#   Vault name      — portal constructs obsidian://open?vault=<name> and
#                     hands it to the browser, opening your local Obsidian app.
#                     Use this when you have Obsidian installed on this machine.
#
#   Full URI        — used as-is (e.g. obsidian://open?vault=coco-workbooks&file=Home)
#
# Examples:
#   OBSIDIAN_VAULT_URL=coco-workbooks          # local Obsidian, coco vault
#   OBSIDIAN_VAULT_URL=                        # containerized Obsidian (default)
OBSIDIAN_VAULT_URL=


# ── Egeria Advisor ────────────────────────────────────────────────────────────
# URL of the Egeria Advisor service if running on a non-default host/port.
# Checked server-side; defaults to http://localhost:8880/. For a public
# deployment (SITE_URL on a real domain), use Advisor's public HTTPS URL here
# instead of localhost — see demo-mode.md § Egeria Advisor integration.
EGERIA_ADVISOR_URL=

# Shared HS256 secret with Egeria Advisor's own ADVISOR_PORTAL_SECRET, used to
# mint the SSO handoff token for the "Ask Advisor" tile. Leave blank to disable
# the tile's SSO handoff (see demo-mode.md § Egeria Advisor integration).
EGERIA_ADVISOR_SSO_SECRET=

# ── Resource Explorer ─────────────────────────────────────────────────────────
# Same "trellis" family app as Egeria Advisor above — same SSO handoff, same
# EGERIA_ADVISOR_SSO_SECRET (its compose config reads this same value in as
# TRELLIS_PORTAL_SECRET). URL of the Resource Explorer service if running on a
# non-default host/port; defaults to http://localhost:8810/. For a public
# deployment use Resource Explorer's public HTTPS URL here instead of
# localhost, same caveat as EGERIA_ADVISOR_URL above.
EGERIA_RESOURCE_EXPLORER_URL=


# ── MCP access token ─────────────────────────────────────────────────────────
# The token the Portal's MCP endpoints require (PO-82): no default.
# quick-start-local generates one into .env on the first run and keeps it;
# leave it unset and the MCP endpoints are off. The value this stack used to
# publish is refused. Clients (for example the Call Dr. Egeria Obsidian
# plugin) send it as X-API-Key or ?token=; copy it from .env.
# MCP_ACCESS_TOKEN=


# ── my-egeria persona ─────────────────────────────────────────────────────────
# Persona used by the my-egeria Textual app (single-user V1).
# All browser sessions share this persona. Change to any Coco Pharmaceuticals
# user (e.g. peterprofile, faithbroker) to explore a different profile.
QUICKSTART_PERSONA_USER=erinoverview
# Also the Portal's (pyegeria-web's) Egeria password (PO-45). No default in the compose file:
# quick-start-local writes the Coco demo persona password here when it is missing. Change it
# together with the user directory (personas.json and the .omsecrets files).
QUICKSTART_PERSONA_PASSWORD=secret


# ── Shared PostgreSQL admin role ──────────────────────────────────────────────
# Used by bin/apply-postgres-init.sh to run the PostgreSQL init scripts.
# The defaults below match the egeria_admin role created by the postgres init
# SQL and work out of the box for the local quickstart — leave them unset unless
# you customised the postgres setup. (The script exports PGPASSWORD so psql does
# not prompt.)
# PGUSER=egeria_admin
# PGPASSWORD=admin4egeria
