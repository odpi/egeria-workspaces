#
# Trellis optional runtime — demo profile environment.
# Copy to .env in this directory before `docker compose ... up`.
#
# See README.md for the full bring-up sequence and docs/runtime-architecture-
# plan.md (trellis repo) for the design behind the tier/GPU choices below.

# ── Model tier, per box ──────────────────────────────────────────────────
# From runtime-architecture-plan.md §5's tier table. Sets which Ollama
# model(s) load and (once the apps implement tier support — see
# docker-compose.yaml's header note; NOT implemented as of 2026-09-04) the
# context cap and RAG context budget that keep time-to-first-token
# reasonable on CPU-only boxes.
#
#   demo-gpu  — Dev 2 / hedwig (Radeon 890M, ROCm) and trevor once its
#               NVIDIA driver + nvidia-container-toolkit are installed:
#               llama3.1:8b general model, codellama:13b for code, 8k
#               context cap, 2k RAG context budget. Measured on hedwig:
#               22.5 s time-to-first-token at a 5.3k-token prompt.
#   demo-cpu  — Demo 1 "cray" and trevor until its driver is installed:
#               llama3.1:8b for every task slot (including code — the 13B
#               code model is not used on CPU boxes), 8k context cap, 2k RAG
#               context budget. NOT interactive: measured ~175s
#               time-to-first-token at 5.3k tokens on hedwig's CPU path,
#               expected worse (several minutes) on the older Zen2/10th-gen
#               boxes cray and trevor actually run. Demo these boxes on
#               Egeria + non-LLM Resource Explorer paths (survey, publish,
#               curate, reports); reserve LLM-interactive demos (EA chat,
#               RE ask) for a demo-gpu box.
#
# Per-box setting, chosen when this compose is brought up on that box:
#   hedwig            -> demo-gpu   (use docker-compose.ollama-rocm.yaml)
#   trevor (post-driver) -> demo-gpu (use docker-compose.ollama-nvidia.yaml)
#   trevor (pre-driver), cray -> demo-cpu (no GPU overlay)
# One value feeds both apps (EA reads it as ADVISOR_MODEL_TIER, RE as EXPLORER_MODEL_TIER).
TRELLIS_MODEL_TIER=demo-cpu

# Context cap / RAG context budget: NOT currently exposed as an env var by
# either app (checked resource_explorer/config.py's LLMConfig/RAGConfig and
# advisor/config.py — neither has a num_ctx or context-budget field; RAGConfig
# has top_k/min_score/max_collections_per_query only, no token budget). The
# plan's §5 describes this as app-side, set per tier once tier support lands
# — there is no env knob to set here yet. Leaving this noted rather than
# inventing a var name nothing reads.
# TRELLIS_CONTEXT_CAP=8k          # not read by either app yet
# TRELLIS_RAG_CONTEXT_BUDGET=2k   # not read by either app yet

# ── Models actually loaded today (both apps read these; see each app's own
# LLM__OLLAMA__* / OLLAMA_* config) ─────────────────────────────────────────
TRELLIS_MODEL_GENERAL=llama3.1:8b
# demo-cpu boxes: leave this equal to TRELLIS_MODEL_GENERAL (13B is not used
# on CPU per the tier table above). demo-gpu boxes (hedwig, trevor
# hedwig only, which has the memory for it): set to codellama:13b. trevor
# stays on llama3.1:8b for every slot (8 GB VRAM; owner's decision 2026-09-04).
TRELLIS_MODEL_CODE=llama3.1:8b

# ── Process role (read by the image entrypoint: WORKERS → uvicorn --workers,
# EMBED_WORKER → resource-explorer web --embed-worker/--no-embed-worker) ────
TRELLIS_RE_WEB_WORKERS=2

# ── Postgres / pgvector — shared-infra's egeria-shared-postgres. Password
# must match docker-entrypoint-initdb.d/init_egeria.sql's `egeria_advisor`
# role (../../shared-infra/docker-entrypoint-initdb.d/init_egeria.sql);
# only override if that file was changed on this box. ──────────────────────
PGVECTOR_PASSWORD=advisor

# ── Egeria service-account fallback (used only for background/anonymous
# calls with no logged-in session — see advisor.auth.resolve_egeria_credentials
# and EgeriaConfig in resource_explorer/config.py) ──────────────────────────
EGERIA_USER=erinoverview
EGERIA_USER_PASSWORD=secret

# ── Portal SSO ───────────────────────────────────────────────────────────
# Shared HS256 secret between this Advisor instance and the Portal
# (egeria-quickstart's EGERIA_ADVISOR_SSO_SECRET, set in
# ../../egeria-quickstart/.env). Must be identical on both sides or the
# Portal's Advisor tile shows "Not configured". Leave blank to disable SSO.
# One shared Portal handoff secret feeds both apps (RE reads it as TRELLIS_PORTAL_SECRET).
ADVISOR_PORTAL_SECRET=

# Extra CORS origin(s) for the Advisor API, comma-separated, if a Portal on
# a different origin calls it directly (rare on a single-box LAN demo).
ADVISOR_EXTRA_CORS_ORIGINS=

# ── Auth ────────────────────────────────────────────────────────────────────
# Shared app-JWT secret for every trellis container on this box (RE web, RE
# worker, EA web, CLI runs). Required. Generate once: openssl rand -hex 32
TRELLIS_JWT_SECRET=
# GitHub API token used by Resource Explorer for surveys and discovery. Without
# it GitHub allows 60 unauthenticated calls per hour, which one survey exhausts.
GITHUB_TOKEN=
