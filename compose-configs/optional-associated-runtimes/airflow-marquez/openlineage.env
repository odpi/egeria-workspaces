# OpenLineage configuration for Airflow
# This file is managed by switch-lineage.sh
# Set ./switch-lineage.sh [marquez|egeria|both] to change where the lineage events go.

# The primary transport configuration

# Airflow OpenLineage settings
AIRFLOW__OPENLINEAGE__NAMESPACE=egeria-workspace
AIRFLOW__OPENLINEAGE__DISABLED=false

# Logging level for OpenLineage (helpful for debugging)
OPENLINEAGE_AIRFLOW_LOGGING=DEBUG

AIRFLOW__OPENLINEAGE__TRANSPORT={"type": "http", "url": "http://host.docker.internal:6000", "endpoint": "api/v1/lineage"}
