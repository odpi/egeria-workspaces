# Copy to .env and fill in. .env is git-ignored; never commit it.

# Image (pinned; see the comment in docker-compose.yaml before moving it).
TESTGEN_IMAGE=datakitchen/dataops-testgen:v5.134.0

# TestGen UI login, created by `setup-system-db`.
TESTGEN_USERNAME=admin
TESTGEN_PASSWORD=

# TestGen's secrets for encrypting stored connection passwords and signing
# tokens. Generate each with: openssl rand -hex 32
# Keep them stable: changing the decrypt pair makes stored connections unreadable.
TG_DECRYPT_SALT=
TG_DECRYPT_PASSWORD=
TG_JWT_HASHING_KEY=

# Password of the testgen_admin role on egeria-shared-postgres:5442.
# Set the same value on the role (README, "Metadata database").
TESTGEN_DB_PASSWORD=

# Read-only account TestGen uses on the example target databases.
TESTGEN_TARGET_DB_USER=surveyor
TESTGEN_TARGET_DB_PASSWORD=surveyor4egeria
