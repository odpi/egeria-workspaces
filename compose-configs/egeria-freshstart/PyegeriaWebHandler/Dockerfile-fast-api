# Dockerfile
# Use a slim Python image for smaller size
FROM docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

# Set environment variables to prevent Python from writing .pyc files
# and to ensure stdout/stderr are unbuffered
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Set the working directory inside the container
WORKDIR /app

# Copy requirements.txt and install dependencies
# This step is often done first to leverage Docker's build cache
COPY requirements.txt .
RUN pip install --no-cache-dir --retries 10 --timeout 60 -r requirements.txt
# Floor at 6.0.16.16: 6.0.14.4/.5 ship a broken get_notes_for_note_log
# (sends an unrecognized type "Note" → 500), which empties the Note Logs tab;
# 6.0.16.16 adds External Identifier support (External Identifiers tab);
# 6.0.17.5 adds support for AI-ready data metrics and Vega-Lite chart generators;
# 6.0.17.21 fixes Classify Term as Question sending Create-style default
# fields (Is Own Anchor/Merge Update/Parent at End1) into the classification
# request body, which the backend rejected with a generic "Request body
# failed validation" error (found 2026-08-12 processing RE's Scouting
# Question glossary terms).
#
# NOTE: this RUN line is cached by Docker like any other layer, and an
# in-container `pip install --upgrade pyegeria` does NOT survive the
# container being recreated (site-packages lives in the image, only
# ./PyegeriaWebHandler:/app is mounted). quick-start-local/fresh-start-local
# pass PYEGERIA_VERSION=pyegeria==<latest or --pyegeria-version pin> plus
# PYEGERIA_BUST=<that version> on every run (compose-configs/shared-infra/
# resolve-pyegeria.sh), so the layer rebuilds exactly when the version
# changes. The default below is only the floor for a plain compose build.
ARG PYEGERIA_VERSION=pyegeria>=6.2.21
ARG PYEGERIA_BUST=0
RUN echo "pyegeria layer ${PYEGERIA_BUST}" \
    && pip install --no-cache-dir --retries 10 --timeout 60 "${PYEGERIA_VERSION}" --upgrade

# Copy your application code
# Assuming your FastAPI app is in 'main.py' at the root of your app directory
COPY . .

# Expose the port your ASGI server will listen on
EXPOSE 8000

# Command to run your FastAPI application with Uvicorn (or Gunicorn + Uvicorn workers)
# Using Gunicorn with Uvicorn workers is recommended for production for process management
#CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "main:app", "--bind", "0.0.0.0:8000"]
# Or for simple development:
 CMD ["uvicorn", "pyegeria_handler:app", "--host", "::", "--port", "8000", "--reload"]