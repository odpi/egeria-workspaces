# Both stacks (quickstart and freshstart) pin the same 6.4-SNAPSHOT build, the
# first with solution boundaries (odpi/egeria#9465). Move the tag here and
# --refresh-platform follows it. (Before 6.3 the :latest digest predated
# DCATContentPack (#849), so fs-metadata-store failed to start and the
# container looped (TR-36); a pin avoids that.)
FROM docker.io/odpi/egeria-platform:6.4-SNAPSHOT@sha256:5a8d6a128e011db5d9eda698f8d46d3c389f59100d69eab31428a0390000309f

# Freshstart secrets are runtime-mounted from runtime-volumes/freshstart-platform-data/secrets.

