# ─────────────────────────────────────────────────────────────────────────────
# egeria-freshstart — environment configuration template
# Copy this file to .env and fill in values for your environment.
# .env is gitignored; .env.example is committed and kept up to date.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host / network ────────────────────────────────────────────────────────────
# Fully-qualified hostname of this machine.
HOST_FQDN=myhost.local

# Kafka bootstrap address reachable from inside containers.
KAFKA_BOOTSTRAP_SERVERS=myhost.local:9194

CONFIG_JSON=""

# The Portal service account password (PO-45): no default; the stack refuses to start without it.
# fresh-start-local keeps it across runs and never makes one up.
# EGERIA_ADMIN_CALLER_PASSWORD=

# The token the Portal's MCP endpoints require (PO-79): no default. fresh-start-local generates one into .env on the first run and
# keeps it; leave it unset and the MCP endpoints are off. The value this stack used to publish is refused.
# Clients (for example the Call Dr. Egeria Obsidian plugin) send it as X-API-Key or ?token=.
# MCP_ACCESS_TOKEN=
