#!/usr/bin/env bash
set -euo pipefail

# Always run from repo root (this script lives at repo root)
cd "$(dirname "$0")"
REPO_ROOT="$(pwd)"

source compose-configs/shared-infra/detect-engine.sh
source compose-configs/shared-infra/compose-build-flags.sh

print_usage() {
  cat <<'EOF'
Usage: ./quick-start-local [OPTIONS]

Every run (demo or not) gets HTTPS via Apache on port 8843 by default, using
a self-signed certificate auto-generated into runtime-volumes/certs-quickstart
on first run (browsers will warn — accept it once). To use a real certificate
instead, put "CERT_DIR=/path/to/certs" (containing server.crt, server.key,
server-ca.crt) in compose-configs/egeria-quickstart/.env.ssl.

Options:
  --refresh-platform  Force rebuild of egeria-main so the container engine pulls
                      the latest base image.
  --refresh-pyegeria  Force pyegeria-web and jupyter to re-resolve the latest
                      pyegeria release. pyegeria's `pip install --upgrade` is
                      a cached Docker layer, so a plain rebuild otherwise
                      keeps whatever version was resolved when the image was
                      last built, even though requirements.txt has no upper
                      version bound. (Same fix as bin/update-pyegeria.sh, but
                      only busts the pyegeria layer instead of rebuilding the
                      whole image with --no-cache, and also covers jupyter,
                      which that script doesn't.)
  --demo              Enable demo mode: activates user registration, auth gating,
                      and moves HTTPS to port 443 with a real certificate
                      instead of the self-signed default above. On first run,
                      prompts for the TLS certificate directory and admin
                      credentials; saves them to
                      compose-configs/egeria-quickstart/.env.demo for reuse.
                      See compose-configs/egeria-quickstart/PyegeriaWebHandler/demo-mode.md
  --sync-from HOST:REMOTE_DIR
                      Before starting, pull the latest demo user/feedback data
                      (demo_auth + demo schemas) from another machine that
                      isn't running the Portal right now — e.g.
                      --sync-from hedwig:egeria-workspaces/runtime-volumes/demo-sync
                      Requires key-based SSH to HOST already working (unless
                      --remote-password is used). Failure only warns;
                      startup continues with local data.
  --sync-to HOST:REMOTE_DIR
                      Push the latest local demo user/feedback data to
                      another machine.
  --remote-user USER  SSH user for remote sync operations.
  --remote-password PASS
                      SSH password for remote sync operations (requires sshpass).
  --only-sync         Perform sync operations and exit without starting Egeria.
  --egeria-memory SIZE
                      Set egeria-main's container memory cap (Docker/Podman
                      `mem_limit` syntax, e.g. 4g, 8g, 10240m). Defaults to 6g
                      if never set. Persists in
                      compose-configs/egeria-quickstart/.env, so it only needs
                      to be passed once — plain re-runs without this flag keep
                      using the last value set. Raise this if egeria-main is
                      being OOM-killed (exit 137); lower it if your machine's
                      total memory is tight and other containers are starving.
  --egeria-cpus N     Set egeria-main's container CPU cap (Docker/Podman
                      `cpus` syntax, e.g. 4, 4.5, 6). Defaults to 4 if never
                      set. Persists in compose-configs/egeria-quickstart/.env
                      like --egeria-memory above. Unlike the memory cap, this
                      isn't an OOM-kill defense — egeria-main going unbounded
                      on CPU can starve every other container (and the Docker
                      Desktop VM's own kernel threads) badly enough to crash
                      them, e.g. Postgres crashing under a checkpoint that
                      can't get scheduled. Raise this if egeria-main itself
                      needs to run faster and your machine has cores to
                      spare; lower it if other containers are still starving.
  --skip-unity-catalog
                      Don't deploy the Unity Catalog demo containers (the two
                      Unity Catalog servers + UIs from
                      compose-configs/optional-associated-runtimes/unity-catalog,
                      used for the Coco Pharmaceuticals clinical_trials
                      scenario). Deployed automatically by default; failure
                      only warns, startup continues either way.
  -h, --help          Show this help text.
EOF
}

REFRESH_PLATFORM=0
REFRESH_PYEGERIA=0
DEMO_MODE_FLAG=0
SYNC_FROM=""
SYNC_TO=""
REMOTE_USER="${REMOTE_USER:-}"
REMOTE_PASSWORD="${REMOTE_PASSWORD:-}"
ONLY_SYNC=0
EGERIA_MEM_LIMIT="${EGERIA_MEM_LIMIT:-}"
EGERIA_CPU_LIMIT="${EGERIA_CPU_LIMIT:-}"
SKIP_UNITY_CATALOG=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --refresh-platform)
      REFRESH_PLATFORM=1
      shift
      ;;
    --refresh-pyegeria)
      REFRESH_PYEGERIA=1
      shift
      ;;
    --demo)
      DEMO_MODE_FLAG=1
      shift
      ;;
    --egeria-memory)
      EGERIA_MEM_LIMIT="$2"
      shift 2
      ;;
    --egeria-cpus)
      EGERIA_CPU_LIMIT="$2"
      shift 2
      ;;
    --skip-unity-catalog)
      SKIP_UNITY_CATALOG=1
      shift
      ;;
    --sync-from)
      SYNC_FROM="$2"
      shift 2
      ;;
    --sync-to)
      SYNC_TO="$2"
      shift 2
      ;;
    --remote-user)
      REMOTE_USER="$2"
      shift 2
      ;;
    --remote-password)
      REMOTE_PASSWORD="$2"
      shift 2
      ;;
    --only-sync)
      ONLY_SYNC=1
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      echo "[quick-start-local] Unknown option: $1" >&2
      print_usage >&2
      exit 1
      ;;
  esac
done

image_exists() {
  local image_ref="$1"
  $CONTAINER_ENGINE image inspect "$image_ref" >/dev/null 2>&1
}

ensure_service_image() {
  local service_name="$1"
  local image_ref="$2"
  local required="${3:-1}"
  local force_rebuild="${4:-0}"

  if [[ "$force_rebuild" -eq 0 ]] && image_exists "$image_ref"; then
    echo "[quick-start-local] Using existing local image for ${service_name}: ${image_ref}"
    return 0
  fi

  if [[ "$force_rebuild" -eq 1 ]]; then
    echo "[quick-start-local] Refreshing ${service_name} image (${image_ref}) to pull latest base image..."
  else
    echo "[quick-start-local] Local image missing for ${service_name} (${image_ref}); attempting build..."
  fi
  if ! $COMPOSE_CMD -p egeria-quickstart -f egeria-quickstart.yaml build "${COMPOSE_BUILD_FLAGS[@]}" "$service_name"; then
    echo "[quick-start-local] Pull-enabled build failed for ${service_name}; retrying without pull..."
    if ! $COMPOSE_CMD -p egeria-quickstart -f egeria-quickstart.yaml build "$service_name"; then
      if [[ "$required" -eq 1 ]]; then
        echo "[quick-start-local] ERROR: unable to build required service '${service_name}' and no local image exists (${image_ref})." >&2
        return 1
      fi
      echo "[quick-start-local] WARNING: unable to build optional service '${service_name}'."
      return 2
    fi
  fi

  if image_exists "$image_ref"; then
    return 0
  fi

  if [[ "$required" -eq 1 ]]; then
    echo "[quick-start-local] ERROR: build finished but local image still not found for ${service_name} (${image_ref})." >&2
    return 1
  fi

  return 2
}

# Podman 3.x: podman-compose silently skips external networks at container creation.
# Calling network connect on a running container takes effect immediately — the
# container becomes resolvable on egeria_network without any restart. DO NOT
# stop/start service containers after connecting; that reverts them to their
# creation-time networks (podman only).
_podman_fix_network() {
  for c in "$@"; do
    if podman network connect egeria_network "$c" 2>/dev/null; then
      echo "[quick-start-local] Connected $c to egeria_network"
    fi
    # exit 125 = already connected — nothing to do
  done
}

# Restart Apache so its DNS resolver picks up all containers now on egeria_network.
# Apache retains egeria_network across a stop/start (unlike service containers).
_podman_restart_apache() {
  echo "[quick-start-local] Restarting apache-web to refresh DNS resolver..."
  podman stop quickstart-web-server 2>/dev/null || true
  podman start quickstart-web-server || echo "[quick-start-local] WARNING: apache-web failed to restart"
}

echo "[quick-start-local] Preparing environment (.env) and compose files..."
echo "[quick-start-local] Quickstart uses image-provided secrets and mounts runtime data/logs only."

mkdir -p runtime-volumes/quickstart-platform-data/data runtime-volumes/quickstart-platform-data/logs
prepare_runtime_dir "runtime-volumes/quickstart-platform-data"
prepare_runtime_dir "work"
prepare_runtime_dir "workbooks"
prepare_runtime_dir "coco-workbooks"
prepare_runtime_dir "exchange-quickstart"
prepare_runtime_dir "runtime-volumes/obsidian-config"

# Seed Obsidian vault selection on first run (auto-opens coco-workbooks vault)
_obs_json="runtime-volumes/obsidian-config/obsidian/obsidian.json"
if [[ ! -f "$_obs_json" ]]; then
  mkdir -p "$(dirname "$_obs_json")"
  cp compose-configs/egeria-quickstart/obsidian-config/obsidian.json "$_obs_json"
  echo "[quick-start-local] Seeded Obsidian vault config (coco-workbooks)."
fi

# Copy the quickstart server configurations to the runtime volume
TARGET_SERVER_DIR="runtime-volumes/quickstart-platform-data/data/servers"
echo "[quick-start-local] Copying quickstart server configurations to ${TARGET_SERVER_DIR}..."
safe_rm_rf "$TARGET_SERVER_DIR"
mkdir -p "$TARGET_SERVER_DIR"
cp compose-configs/egeria-quickstart/servers/*.http "$TARGET_SERVER_DIR"/
cp compose-configs/egeria-quickstart/servers/README.md "$TARGET_SERVER_DIR"/
cp -r compose-configs/egeria-quickstart/servers/qs-* "$TARGET_SERVER_DIR"/

RUNTIME_SECRETS_DIR="runtime-volumes/quickstart-platform-data/secrets"
safe_rm_rf "$RUNTIME_SECRETS_DIR"
mkdir -p "$RUNTIME_SECRETS_DIR"
cp compose-configs/egeria-quickstart/secrets/*.omsecrets "$RUNTIME_SECRETS_DIR"/

compose-configs/shared-infra/ensure-shared-infra.sh
compose-configs/egeria-quickstart/bin/apply-postgres-init.sh

export REMOTE_USER REMOTE_PASSWORD

if [[ -n "$SYNC_FROM" ]]; then
  _sync_host="${SYNC_FROM%%:*}"
  _sync_dir="${SYNC_FROM#*:}"
  echo "[quick-start-local] Pulling latest demo user/feedback data from ${_sync_host}:${_sync_dir}..."
  if ! compose-configs/egeria-quickstart/bin/sync-demo-db.sh pull "$_sync_host" "$_sync_dir" -y; then
    echo "[quick-start-local] WARNING: Could not pull demo data from ${SYNC_FROM} — continuing with local data." >&2
  fi
fi

if [[ -n "$SYNC_TO" ]]; then
  _sync_host="${SYNC_TO%%:*}"
  _sync_dir="${SYNC_TO#*:}"
  echo "[quick-start-local] Pushing latest demo user/feedback data to ${_sync_host}:${_sync_dir}..."
  if ! compose-configs/egeria-quickstart/bin/sync-demo-db.sh push "$_sync_host" "$_sync_dir"; then
    echo "[quick-start-local] WARNING: Could not push demo data to ${SYNC_TO}." >&2
  fi
fi

if [[ "$ONLY_SYNC" -eq 1 ]]; then
  echo "[quick-start-local] Sync complete (--only-sync). Exiting."
  exit 0
fi

pushd compose-configs/egeria-quickstart >/dev/null

  # Read a key from a file without sourcing it (avoids shell injection).
  _get_env_var() {
    local key="$1" file="$2"
    [[ -f "$file" ]] && grep -E "^${key}=" "$file" | head -n1 | cut -d= -f2- || true
  }

  # ── Demo mode: collect / persist credentials ─────────────────────────────
  _jwt="" _cert_dir="" _admin_email="" _admin_pass="" _resend_key="" _resend_from="" _https_port="" _site_url_override="" _advisor_url="" _advisor_secret=""
  if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
    ENV_DEMO=".env.demo"
    echo "[quick-start-local] Demo mode: loading configuration..."

    # Priority: .env.demo (saved secrets) > .env (primed from existing config).
    _pick() {
      local key="$1"
      local v
      v="$(_get_env_var "$key" "$ENV_DEMO")"
      [[ -z "$v" ]] && v="$(_get_env_var "$key" ".env")"
      printf '%s' "$v"
    }

    _jwt="$(_pick JWT_SECRET)"
    _cert_dir="$(_pick CERT_DIR)"
    _admin_email="$(_pick ADMIN_BOOTSTRAP_EMAIL)"
    _admin_pass="$(_pick ADMIN_BOOTSTRAP_PASSWORD)"
    _resend_key="$(_pick RESEND_API_KEY)"
    _resend_from="$(_pick RESEND_FROM)"
    _https_port="$(_pick HTTPS_PORT)"
    _site_url_override="$(_pick SITE_URL)"
    _advisor_url="$(_pick EGERIA_ADVISOR_URL)"
    _advisor_secret="$(_pick EGERIA_ADVISOR_SSO_SECRET)"

    # Generate JWT_SECRET if not already set
    if [[ -z "$_jwt" ]]; then
      _jwt="$(openssl rand -hex 32 2>/dev/null \
        || python3 -c 'import secrets; print(secrets.token_hex(32))' 2>/dev/null)"
      echo "[quick-start-local]   Generated new JWT_SECRET."
    fi

    # Prompt for admin credentials if not set (needed above the cert-dir
    # prompt below — the admin email doubles as the Let's Encrypt contact
    # address if we end up falling back to it).
    if [[ -z "$_admin_email" ]]; then
      read -r -p "[quick-start-local]   Admin bootstrap email: " _admin_email
    fi
    if [[ -z "$_admin_pass" ]]; then
      read -r -s -p "[quick-start-local]   Admin bootstrap password: " _admin_pass
      echo
    fi

    # Resend email — prompt if not yet configured (blank = no email; that's valid)
    if [[ -z "$_resend_key" ]]; then
      echo "[quick-start-local]   Resend API key for email verification / password reset."
      echo "[quick-start-local]   Leave blank to skip email (accounts must be verified manually via /admin)."
      read -r -p "[quick-start-local]   RESEND_API_KEY: " _resend_key
    fi
    if [[ -n "$_resend_key" && -z "$_resend_from" ]]; then
      read -r -p "[quick-start-local]   Sender address (e.g. 'Egeria Demo <noreply@yourdomain.com>'): " _resend_from
    fi

    # Public SITE_URL — may differ from HOST_FQDN (e.g. egeria.pdr-associates.com vs internal hostname)
    # Used in email verification/reset links, the Secure cookie flag, and (below)
    # as the domain requested from Let's Encrypt if no cert directory is given.
    if [[ -z "$_site_url_override" ]]; then
      _https_port_num="${_https_port:-443}"
      _default_site_url="https://$(hostname -f 2>/dev/null || hostname)"
      [[ "$_https_port_num" != "443" ]] && _default_site_url="${_default_site_url}:${_https_port_num}"
      echo "[quick-start-local]   Public-facing HTTPS URL (used in email links — must be reachable by recipients)."
      read -r -p "[quick-start-local]   SITE_URL [${_default_site_url}]: " _site_url_override
      _site_url_override="${_site_url_override:-$_default_site_url}"
    fi

    # Prompt for TLS cert directory if not set. Leave blank to have
    # quick-start-local obtain one automatically from Let's Encrypt instead
    # (requires SITE_URL's domain to already resolve to this host and port 80
    # to be reachable from the internet — see egeria-quickstart-letsencrypt.yaml).
    _letsencrypt_pending=0
    _letsencrypt_domain=""
    if [[ -z "$_cert_dir" ]]; then
      _default_certs="$(cd "../../runtime-volumes/certs" 2>/dev/null && pwd || true)"
      echo "[quick-start-local]   TLS cert dir must contain: server.crt, server.key, server-ca.crt"
      echo "[quick-start-local]   Leave blank to have Let's Encrypt obtain one automatically for ${_site_url_override#https://}."
      read -r -p "[quick-start-local]   Certificate directory (blank = Let's Encrypt) [${_default_certs}]: " _cert_dir
      if [[ -z "$_cert_dir" && -z "$_default_certs" ]]; then
        _letsencrypt_domain="${_site_url_override#https://}"
        _letsencrypt_domain="${_letsencrypt_domain%%/*}"
        _letsencrypt_domain="${_letsencrypt_domain%%:*}"
        _cert_dir="$(cd ../.. && pwd)/runtime-volumes/certs-letsencrypt"
        _letsencrypt_pending=1
        echo "[quick-start-local]   Will request a Let's Encrypt certificate for ${_letsencrypt_domain} once apache-web is up."
        # A cert must already exist for Apache's SSL vhost to start at all —
        # generate a temporary self-signed one now; letsencrypt-cert.sh
        # overwrites it with the real cert further down, then apache-web
        # gets restarted to pick it up (Apache doesn't hot-reload cert files).
        ../../generate-certs.sh "$_cert_dir" "$_letsencrypt_domain"
      else
        _cert_dir="${_cert_dir:-$_default_certs}"
      fi
      _cert_dir="${_cert_dir/#\~/$HOME}"
      if [[ "$_cert_dir" != /* ]]; then
        _cert_dir="$(cd "$(pwd)/../../${_cert_dir}" 2>/dev/null && pwd)" || _cert_dir="$(pwd)/../../${_cert_dir}"
      fi
    fi
    if [[ ! -d "$_cert_dir" ]]; then
      echo "[quick-start-local] WARNING: '${_cert_dir}' is not a directory — SSL will fail until CERT_DIR is fixed in ${ENV_DEMO}." >&2
    fi

    # Save credentials to .env.demo (mode 600 — contains secrets)
    # Note: EGERIA_ADVISOR_SSO_SECRET is deliberately NOT auto-generated like
    # JWT_SECRET is — it's a secret shared with an independently-deployed
    # Egeria Advisor instance, so a locally-generated value would silently
    # desync from whatever is already in Advisor's own .env. Leave blank
    # (SSO handoff tile shows "Not configured") until you paste in the exact
    # value from the Advisor machine.
    cat > "$ENV_DEMO" <<EOF
JWT_SECRET=${_jwt}
CERT_DIR=${_cert_dir}
ADMIN_BOOTSTRAP_EMAIL=${_admin_email}
ADMIN_BOOTSTRAP_PASSWORD=${_admin_pass}
RESEND_API_KEY=${_resend_key}
RESEND_FROM=${_resend_from}
HTTPS_PORT=${_https_port}
SITE_URL=${_site_url_override}
EGERIA_ADVISOR_URL=${_advisor_url}
EGERIA_ADVISOR_SSO_SECRET=${_advisor_secret}
EOF
    chmod 600 "$ENV_DEMO"
    echo "[quick-start-local]   Demo credentials saved to ${ENV_DEMO}."
  fi

  # ── Non-demo mode: fall back to a self-signed cert unless the user has ──
  # already configured one in .env.ssl (or .env). Demo mode always requires
  # a real cert (collected above) and is left untouched.
  if [[ "$DEMO_MODE_FLAG" -eq 0 ]]; then
    ENV_SSL=".env.ssl"
    _cert_dir="$(_get_env_var CERT_DIR "$ENV_SSL")"
    [[ -z "$_cert_dir" ]] && _cert_dir="$(_get_env_var CERT_DIR .env)"
    _https_port="$(_get_env_var HTTPS_PORT "$ENV_SSL")"
    _site_url_override="$(_get_env_var SITE_URL "$ENV_SSL")"

    if [[ -z "$_cert_dir" ]]; then
      _cert_dir="$(cd ../.. && pwd)/runtime-volumes/certs-quickstart"
    fi

    if [[ ! -f "${_cert_dir}/server.crt" || ! -f "${_cert_dir}/server.key" || ! -f "${_cert_dir}/server-ca.crt" ]]; then
      _cert_host="$(hostname -f 2>/dev/null || hostname)"
      echo "[quick-start-local] No TLS certificate found at ${_cert_dir}; generating a self-signed one for ${_cert_host}..."
      ../../generate-certs.sh "$_cert_dir" "$_cert_host"
    fi

    _https_port="${_https_port:-8843}"

    # Persist so the same self-signed cert (and chosen port/SITE_URL) is reused
    # across runs instead of being regenerated — browsers only need to trust
    # a self-signed cert once. SITE_URL is only written if the user set one
    # (blank is fine — it's re-derived from HOST_FQDN below on every run).
    cat > "$ENV_SSL" <<EOF
CERT_DIR=${_cert_dir}
HTTPS_PORT=${_https_port}
SITE_URL=${_site_url_override}
EOF
    chmod 600 "$ENV_SSL"
  fi

  # Generate/update .env and normalize exchange-quickstart/config/config.json
  # gen-env.sh runs as a separate process -- EGERIA_MEM_LIMIT/EGERIA_CPU_LIMIT
  # must be exported (not just set) for their --egeria-memory/--egeria-cpus
  # values to be visible there as the highest-priority tier (see gen-env.sh).
  export EGERIA_MEM_LIMIT
  export EGERIA_CPU_LIMIT
  ./gen-env.sh

  # Append demo/TLS vars to .env immediately after gen-env.sh (which rewrites it each run).
  # SITE_URL is computed the same way in both modes — it's the one HTTPS URL
  # the browser actually uses, and everything (cookies' Secure flag, myEgeria's
  # same-origin WebSocket URL, the Pyegeria Publishing Root link) derives from it.
  _host_fqdn="$(grep '^HOST_FQDN=' .env | cut -d= -f2-)"
  if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
    _https_port_num="${_https_port:-443}"
  else
    _https_port_num="${_https_port:-8843}"
  fi
  # Use an explicit SITE_URL override if set (e.g. a public domain that differs
  # from the internal hostname, like egeria.pdr-associates.com vs cray); else derive from HOST_FQDN.
  if [[ -n "$_site_url_override" ]]; then
    _site_url="$_site_url_override"
  elif [[ "$_https_port_num" == "443" ]]; then
    _site_url="https://${_host_fqdn}"
  else
    _site_url="https://${_host_fqdn}:${_https_port_num}"
  fi

  if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
    {
      echo "JWT_SECRET=${_jwt}"
      echo "CERT_DIR=${_cert_dir}"
      echo "ADMIN_BOOTSTRAP_EMAIL=${_admin_email}"
      echo "ADMIN_BOOTSTRAP_PASSWORD=${_admin_pass}"
      echo "RESEND_API_KEY=${_resend_key}"
      echo "RESEND_FROM=${_resend_from}"
      echo "HTTPS_PORT=${_https_port_num}"
      echo "SITE_URL=${_site_url}"
      echo "EGERIA_ADVISOR_URL=${_advisor_url}"
      echo "EGERIA_ADVISOR_SSO_SECRET=${_advisor_secret}"
    } >> .env
    echo "[quick-start-local]   Demo SSL_SERVER_NAME: ${_host_fqdn} — SITE_URL: ${_site_url}"
  else
    {
      echo "CERT_DIR=${_cert_dir}"
      echo "HTTPS_PORT=${_https_port_num}"
      echo "SITE_URL=${_site_url}"
    } >> .env
    echo "[quick-start-local]   Self-signed HTTPS on port ${_https_port_num} (CERT_DIR=${_cert_dir}) — SITE_URL: ${_site_url}"
  fi

  # Generate runtime ssl-define.conf (Apache Defines for SSL_SERVER_NAME and
  # HTTPS_REDIRECT_PORT) — needed in both modes, egeria-quickstart-ssl.yaml
  # mounts it unconditionally. HTTPS_REDIRECT_PORT is what fastapi-proxy.conf's
  # plain-HTTP vhost 301-redirects to.
  SSL_DEFINE_DIR="../../runtime-volumes/quickstart-apache-web"
  mkdir -p "$SSL_DEFINE_DIR"
  {
    printf 'Define SSL_SERVER_NAME %s\n' "${_host_fqdn}"
    printf 'Define HTTPS_REDIRECT_PORT %s\n' "${_https_port_num}"
  } > "${SSL_DEFINE_DIR}/ssl-define.conf"

  # Build the compose file list.
  # - egeria-quickstart-docker.yaml restores service_healthy for Docker
  #   (podman-compose 1.5.0 blocks indefinitely on service_healthy)
  # - egeria-quickstart-ssl.yaml enables Apache HTTPS (self-signed by default,
  #   or a real cert via CERT_DIR) on every run, demo or not
  # - egeria-quickstart-demo.yaml additionally enables DEMO_MODE (auth/registration)
  COMPOSE_FILES=(-f egeria-quickstart.yaml -f egeria-quickstart-local.yaml -f egeria-quickstart-ssl.yaml)
  if [[ "$CONTAINER_ENGINE" != "podman" ]]; then
    COMPOSE_FILES+=(-f egeria-quickstart-docker.yaml)
  fi
  if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
    COMPOSE_FILES+=(-f egeria-quickstart-demo.yaml)
  fi
  # CERT_DIR pointing at the well-known Let's Encrypt output path (set above,
  # first run or subsequent) means this demo is using Let's Encrypt — keep
  # port 80 + the ACME webroot mounted every run, not just the first one,
  # since renew-certs.sh needs it for renewal too.
  if [[ "$DEMO_MODE_FLAG" -eq 1 && "$_cert_dir" == *"/runtime-volumes/certs-letsencrypt" ]]; then
    COMPOSE_FILES+=(-f egeria-quickstart-letsencrypt.yaml)
  fi

  # egeria-platform's FROM line is pinned to a digest (Scorecard's
  # Pinned-Dependencies check), so `docker build --pull` alone would just
  # keep re-confirming the SAME pinned digest forever -- --refresh-platform
  # needs this explicit re-resolve step first to actually pick up a newer
  # image. See compose-configs/shared-infra/pin-latest-digest.sh's own
  # docstring for the full reasoning.
  if [[ "$REFRESH_PLATFORM" -eq 1 ]]; then
    # NOTE: absolute paths -- we are inside the compose-configs/egeria-quickstart
    # pushd here, so repo-root-relative paths would not resolve.
    "$REPO_ROOT/compose-configs/shared-infra/pin-latest-digest.sh" \
      "$REPO_ROOT/compose-configs/egeria-quickstart/Dockerfile-egeria-platform" \
      docker.io/odpi/egeria-platform:latest
  fi

  # pyegeria-web's and jupyter's `pip install --upgrade pyegeria` each sit in
  # their own cached Docker RUN layer (see Dockerfile-fast-api / Dockerfile-
  # jupyter's own PYEGERIA_BUST comments) -- a plain rebuild reuses that
  # layer and keeps whatever version was resolved when the image was last
  # built, even though requirements.txt's `pyegeria>=X` floor has no upper
  # bound. Passing a fresh PYEGERIA_BUST value busts just that one layer
  # (both Dockerfiles echo it into the RUN instruction so its content
  # actually changes), so the subsequent build below re-resolves pyegeria
  # without a full --no-cache rebuild of everything else in the image.
  if [[ "$REFRESH_PYEGERIA" -eq 1 ]]; then
    echo "[quick-start-local] Refreshing pyegeria (pyegeria-web + jupyter)..."
    $COMPOSE_CMD -p egeria-quickstart "${COMPOSE_FILES[@]}" build \
      --build-arg PYEGERIA_BUST="$(date +%s)" \
      pyegeria-web jupyter-hub
  fi

  echo "[quick-start-local] Ensuring core images are available (platform, pyegeria-web, jupyter, my-profile)..."
  ensure_service_image egeria-main egeria-quickstart-platform:local 1 "$REFRESH_PLATFORM"
  ensure_service_image pyegeria-web egeria-quickstart-pyegeria-web:latest 1
  ensure_service_image jupyter-hub egeria-quickstart-jupyter:local 1
  ensure_service_image my-profile egeria-quickstart-my-profile:local 1
  # Optional: alerts on egeria-main crashing/OOM-killing; harmless if the build fails.
  ensure_service_image egeria-watchdog egeria-quickstart-egeria-watchdog:latest 0

  APACHE_BUILD_OK=1
  echo "[quick-start-local] Ensuring apache-web image is available (optional)..."
  if ! ensure_service_image apache-web egeria-quickstart-apache-web:latest 0; then
    APACHE_BUILD_OK=0
  fi

  echo "[quick-start-local] Starting core quickstart stack..."

  if [[ "$CONTAINER_ENGINE" == "podman" ]]; then
    # podman-compose up -d can block indefinitely if prior containers are stuck stopping/starting.
    # Force-remove any leftover quickstart containers before starting fresh.
    for _cname in quickstart-egeria-main quickstart-pyegeria-web quickstart-jupyter-work-full \
                  quickstart-web-server obsidian-quickstart quickstart-my-profile \
                  egeria-quickstart_egeria-main_1; do
      $CONTAINER_ENGINE rm -f "$_cname" >/dev/null 2>&1 || true
    done
    # podman-compose up -d still blocks while polling container state (v1.5.0 bug).
    # Use timeout: containers are created in ~30s; health may take minutes (handled below).
    timeout 60 $COMPOSE_CMD -p egeria-quickstart \
      "${COMPOSE_FILES[@]}" \
      up -d egeria-main pyegeria-web jupyter-hub obsidian egeria-watchdog 2>&1 || true
    _podman_fix_network quickstart-egeria-main quickstart-pyegeria-web \
                        quickstart-jupyter-work-full obsidian-quickstart
    # Apache hasn't started yet — no DNS restart needed here
  else
    if ! $COMPOSE_CMD -p egeria-quickstart \
      "${COMPOSE_FILES[@]}" \
      up -d ${COMPOSE_PULL_FLAGS} egeria-main pyegeria-web jupyter-hub obsidian egeria-watchdog; then
      echo "[quick-start-local] Pull-enabled core up failed; retrying without pull and without build..."
      $COMPOSE_CMD -p egeria-quickstart \
        "${COMPOSE_FILES[@]}" \
        up -d --no-build egeria-main pyegeria-web jupyter-hub obsidian egeria-watchdog
    fi
  fi

  if [[ "$APACHE_BUILD_OK" -eq 1 ]]; then
    echo "[quick-start-local] Starting apache-web..."
    _apache_hint() {
      echo "[quick-start-local] WARNING: apache-web did not start. Core services are running."
      if [[ "${_https_port_num:-8843}" -lt 1024 && "$CONTAINER_ENGINE" == "podman" ]]; then
        echo "[quick-start-local]   Likely cause: rootless Podman cannot bind privileged port ${_https_port_num:-8843}."
        echo "[quick-start-local]   Fix A (session):   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=${_https_port_num:-8843}"
        if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
          echo "[quick-start-local]   Fix B (permanent): set HTTPS_PORT=8443 in .env.demo and re-run --demo"
        else
          echo "[quick-start-local]   Fix B (permanent): set HTTPS_PORT=8843 in .env.ssl"
        fi
      fi
    }

    if [[ "$CONTAINER_ENGINE" == "podman" ]]; then
      $CONTAINER_ENGINE rm -f quickstart-web-server >/dev/null 2>&1 || true
      timeout 30 $COMPOSE_CMD -p egeria-quickstart \
        "${COMPOSE_FILES[@]}" \
        up -d apache-web 2>&1 || _apache_hint
      _podman_fix_network quickstart-web-server
      _podman_restart_apache
    else
      if ! $COMPOSE_CMD -p egeria-quickstart \
        "${COMPOSE_FILES[@]}" \
        up -d ${COMPOSE_PULL_FLAGS} apache-web; then
        echo "[quick-start-local] Pull-enabled apache-web up failed; retrying without pull and without build..."
        if ! $COMPOSE_CMD -p egeria-quickstart \
          "${COMPOSE_FILES[@]}" \
          up -d --no-build apache-web; then
          _apache_hint
        fi
      fi
    fi

    # apache-web is now up with a temporary self-signed cert and (via
    # egeria-quickstart-letsencrypt.yaml) port 80 + the ACME webroot mounted,
    # so it can actually serve the HTTP-01 challenge. Swap in the real cert.
    if [[ "${_letsencrypt_pending:-0}" -eq 1 ]]; then
      echo "[quick-start-local] Requesting Let's Encrypt certificate for ${_letsencrypt_domain}..."
      WEBROOT_DIR="../../runtime-volumes/quickstart-apache-web/acme-challenge"
      if CONTAINER_ENGINE="$CONTAINER_ENGINE" ../../letsencrypt-cert.sh \
          "$_cert_dir" "$_letsencrypt_domain" "$_admin_email" "$WEBROOT_DIR" \
          "../../runtime-volumes/letsencrypt"; then
        echo "[quick-start-local]   Let's Encrypt certificate installed — restarting apache-web to load it..."
        $CONTAINER_ENGINE restart quickstart-web-server
      else
        echo "[quick-start-local] WARNING: Let's Encrypt request failed — continuing with the temporary" >&2
        echo "[quick-start-local]   self-signed certificate at ${_cert_dir}. Check that ${_letsencrypt_domain}" >&2
        echo "[quick-start-local]   already resolves to this host and port 80 is reachable from the" >&2
        echo "[quick-start-local]   internet, then re-run --demo to retry." >&2
      fi
    fi
  fi
popd >/dev/null

echo "[quick-start-local] Waiting for egeria-main to become healthy (Egeria JVM typically takes 2-5 min)..."
_egeria_healthy=0
for _i in $(seq 1 20); do
  _status=$($CONTAINER_ENGINE inspect -f "$INSPECT_STATUS_FORMAT" quickstart-egeria-main 2>/dev/null || echo "not-found")
  if [[ "$_status" == "healthy" ]]; then
    echo "[quick-start-local] egeria-main is healthy."
    _egeria_healthy=1
    break
  fi
  echo "[quick-start-local]   attempt ${_i}/20 — current status: ${_status} (waiting 30s...)"
  sleep 30
done
if [[ $_egeria_healthy -eq 0 ]]; then
  echo "[quick-start-local] WARNING: egeria-main did not reach healthy state within ~10 minutes." >&2
  echo "[quick-start-local]   Check logs: $CONTAINER_ENGINE logs quickstart-egeria-main" >&2
fi

echo "[quick-start-local] Starting my-profile (Textual TUI)..."
pushd compose-configs/egeria-quickstart >/dev/null
if [[ "$CONTAINER_ENGINE" == "podman" ]]; then
  timeout 30 $COMPOSE_CMD -p egeria-quickstart \
    "${COMPOSE_FILES[@]}" \
    up -d my-profile 2>&1 || echo "[quick-start-local] WARNING: my-profile did not start."
  _podman_fix_network quickstart-my-profile
  _podman_restart_apache  # refresh DNS so Apache sees the new my-profile peer
else
  $COMPOSE_CMD -p egeria-quickstart \
    "${COMPOSE_FILES[@]}" \
    up -d ${COMPOSE_PULL_FLAGS} my-profile \
  || $COMPOSE_CMD -p egeria-quickstart \
    "${COMPOSE_FILES[@]}" \
    up -d --no-build my-profile \
  || echo "[quick-start-local] WARNING: my-profile did not start."
fi
popd >/dev/null

if [[ "$SKIP_UNITY_CATALOG" -eq 0 ]]; then
  echo "[quick-start-local] Starting Unity Catalog demo containers (clinical_trials scenario)..."
  UC_COMPOSE_DIR="compose-configs/optional-associated-runtimes/unity-catalog"
  if [[ -f "${UC_COMPOSE_DIR}/uc-ui-compose.yaml" ]]; then
    $COMPOSE_CMD -f "${UC_COMPOSE_DIR}/uc-ui-compose.yaml" -p unitycatalog-egeria up -d \
      || echo "[quick-start-local] WARNING: Unity Catalog containers did not start. Core services are unaffected. Skip with --skip-unity-catalog." >&2
  else
    echo "[quick-start-local] WARNING: ${UC_COMPOSE_DIR}/uc-ui-compose.yaml not found; skipping Unity Catalog." >&2
  fi
fi

echo "[quick-start-local] Done. Useful URLs:"
HOST_FQDN_PRINT=$(grep '^HOST_FQDN=' compose-configs/egeria-quickstart/.env | cut -d= -f2- || echo "localhost")
KAFKA_CLUSTER_ID_PRINT=$(grep '^KAFKA_CLUSTER_ID=' compose-configs/egeria-quickstart/.env | cut -d= -f2- || echo "42")
EGERIA_MEM_LIMIT_PRINT=$(grep '^EGERIA_MEM_LIMIT=' compose-configs/egeria-quickstart/.env | cut -d= -f2- || echo "6g")
EGERIA_CPU_LIMIT_PRINT=$(grep '^EGERIA_CPU_LIMIT=' compose-configs/egeria-quickstart/.env | cut -d= -f2- || echo "4")
echo "  - Effective HOST_FQDN: ${HOST_FQDN_PRINT}"
echo "  - Effective KAFKA_CLUSTER_ID: ${KAFKA_CLUSTER_ID_PRINT}"
echo "  - Effective EGERIA_MEM_LIMIT: ${EGERIA_MEM_LIMIT_PRINT}"
echo "  - Effective EGERIA_CPU_LIMIT: ${EGERIA_CPU_LIMIT_PRINT}"
echo "  - Egeria (platform): https://${HOST_FQDN_PRINT:-localhost}:9443"
echo "  - JupyterHub:        http://${HOST_FQDN_PRINT:-localhost}:8888  (password: egeria)"
echo "  - Obsidian (local):  http://localhost:8860  (WebRTC works on localhost only)"
echo "  - Obsidian (remote): https://${HOST_FQDN_PRINT:-localhost}:8861 (accept self-signed cert in browser)"
if [[ "$SKIP_UNITY_CATALOG" -eq 0 ]]; then
  echo "  - Unity Catalog (coco):    http://${HOST_FQDN_PRINT:-localhost}:8087  (UI: http://${HOST_FQDN_PRINT:-localhost}:3010)"
  echo "  - Unity Catalog (server2): http://${HOST_FQDN_PRINT:-localhost}:8187  (UI: http://${HOST_FQDN_PRINT:-localhost}:3020)"
fi
_site_url_final="$(grep '^SITE_URL=' compose-configs/egeria-quickstart/.env | cut -d= -f2- || echo "https://${HOST_FQDN_PRINT:-localhost}:8843")"
echo "  - Egeria Portal (HTTPS):  ${_site_url_final}  (http://…:8885 redirects here)"
if [[ "$DEMO_MODE_FLAG" -eq 1 ]]; then
  echo "  - Login:                  ${_site_url_final}/login"
else
  echo "  - Portal is self-signed unless CERT_DIR is set in .env.ssl — accept the cert warning once."
  echo "  - My Profile:             ${_site_url_final}/my-egeria/"
fi
