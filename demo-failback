#!/usr/bin/env bash
set -euo pipefail

# demo-failback — one-shot catch-up sync for the moment you hand demo
# production back to its normal machine after a failover.
#
# Scenario this is for:
#   1. cray (normally production) falls over; you point the router at
#      another machine (e.g. hedwig) as a temporary stand-in.
#   2. New users/feedback accumulate on the stand-in while it's live.
#   3. You fix cray. BEFORE flipping the router back, run this ONCE from
#      the stand-in machine, targeting cray. It exports this machine's
#      current demo_auth + demo.feedback data, ships it to the target, and
#      imports it there immediately — so the target isn't missing whatever
#      happened while it was down.
#   4. Flip the router back. Resume normal hourly sync (target exports,
#      stand-in pulls).
#
# This is deliberately a manual, one-time action at the failover boundary —
# NOT something to run on an hourly cron. demo_auth is a full REPLACE on
# import, not a merge (see sync-demo-db.sh's own header for why); running
# this in both directions on a schedule would risk a live signup on the
# normal production machine getting wiped by a stale copy pushed back from
# the stand-in. demo.feedback is safe either way (merged by id).
#
# Usage:
#   ./demo-failback <target-host> --remote-dir DIR [OPTIONS]
#
# Options:
#   --remote-dir DIR       Path to the target's runtime-volumes/demo-sync,
#                           e.g. ~/PycharmProjects/egeria-workspaces/runtime-volumes/demo-sync
#   --remote-repo-dir DIR  Path to the target's repo checkout, used to invoke
#                           sync-demo-db.sh there for the import. Defaults to
#                           --remote-dir with "/runtime-volumes/demo-sync"
#                           stripped off (the normal layout).
#   --remote-user USER     SSH user for the target.
#   --remote-password PASS SSH password for the target (requires sshpass).
#   -y                      Skip the confirmation prompt.
#   -h, --help              Show this help text.
#
# Example (hedwig was standing in, handing production back to cray):
#   ./demo-failback cray --remote-dir ~/PycharmProjects/egeria-workspaces/runtime-volumes/demo-sync --remote-user dan

# Always run from repo root (this script lives at repo root)
cd "$(dirname "$0")"

SYNC_SCRIPT="compose-configs/egeria-quickstart/bin/sync-demo-db.sh"

TARGET_HOST=""
REMOTE_DIR=""
REMOTE_REPO_DIR=""
REMOTE_USER="${REMOTE_USER:-}"
REMOTE_PASSWORD="${REMOTE_PASSWORD:-}"
AUTO_YES=0

print_usage() {
  sed -n '4,42p' "$0" | sed 's/^# \{0,1\}//'
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  print_usage
  exit 0
fi

TARGET_HOST="$1"; shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote-dir)      REMOTE_DIR="$2"; shift 2 ;;
    --remote-repo-dir) REMOTE_REPO_DIR="$2"; shift 2 ;;
    --remote-user)     REMOTE_USER="$2"; shift 2 ;;
    --remote-password) REMOTE_PASSWORD="$2"; shift 2 ;;
    -y)                AUTO_YES=1; shift ;;
    -h|--help)         print_usage; exit 0 ;;
    *)
      echo "[demo-failback] Unknown option: $1" >&2
      print_usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TARGET_HOST" || -z "$REMOTE_DIR" ]]; then
  echo "[demo-failback] ERROR: <target-host> and --remote-dir are required." >&2
  print_usage >&2
  exit 1
fi

if [[ -z "$REMOTE_REPO_DIR" ]]; then
  REMOTE_REPO_DIR="${REMOTE_DIR%/runtime-volumes/demo-sync}"
  if [[ "$REMOTE_REPO_DIR" == "$REMOTE_DIR" ]]; then
    echo "[demo-failback] ERROR: couldn't infer --remote-repo-dir from --remote-dir (${REMOTE_DIR})." >&2
    echo "[demo-failback]   Pass --remote-repo-dir explicitly if the target's demo-sync dir isn't at the usual <repo>/runtime-volumes/demo-sync." >&2
    exit 1
  fi
fi

if [[ "$AUTO_YES" -ne 1 ]]; then
  echo "[demo-failback] This will export THIS machine's current demo data,"
  echo "[demo-failback] ship it to ${TARGET_HOST}, and REPLACE demo_auth"
  echo "[demo-failback] (users, events, favorites, config) there — demo.feedback"
  echo "[demo-failback] will be merged, not replaced."
  read -r -p "[demo-failback] Continue? [y/N] " _confirm
  [[ "$_confirm" =~ ^[Yy]$ ]] || { echo "[demo-failback] Aborted."; exit 1; }
fi

export REMOTE_USER REMOTE_PASSWORD

echo "[demo-failback] Exporting local data and pushing to ${TARGET_HOST}:${REMOTE_DIR}..."
"$SYNC_SCRIPT" push "$TARGET_HOST" "$REMOTE_DIR"

echo "[demo-failback] Importing on ${TARGET_HOST}..."
_ssh_cmd=("ssh" "-o" "StrictHostKeyChecking=no")
_target="${TARGET_HOST}"
if [[ -n "${REMOTE_USER}" && "${TARGET_HOST}" != *@* ]]; then
  _target="${REMOTE_USER}@${TARGET_HOST}"
fi
_remote_import="cd '${REMOTE_REPO_DIR}' && ${SYNC_SCRIPT} import '${REMOTE_DIR}/latest.dump' -y"

if [[ -n "${REMOTE_PASSWORD}" ]]; then
  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "${REMOTE_PASSWORD}" "${_ssh_cmd[@]}" "${_target}" "$_remote_import"
  else
    echo "[demo-failback] WARNING: REMOTE_PASSWORD set but 'sshpass' not found. SSH may prompt for password." >&2
    "${_ssh_cmd[@]}" "${_target}" "$_remote_import"
  fi
else
  "${_ssh_cmd[@]}" "${_target}" "$_remote_import"
fi

echo "[demo-failback] Done. ${TARGET_HOST} now has this machine's data."
echo "[demo-failback] Next steps:"
echo "[demo-failback]   1. Flip the router/traffic back to ${TARGET_HOST}."
echo "[demo-failback]   2. Make sure the normal hourly sync crons are back to their"
echo "[demo-failback]      usual direction (${TARGET_HOST} exports, this machine pulls)."
